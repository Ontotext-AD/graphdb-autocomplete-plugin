@Library("ontotext-platform@v0.1.57") _

pipeline {
  agent {
    label 'aws-large'
  }

  tools {
    maven 'maven3'
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 150, unit: 'MINUTES')
    timestamps()
  }

  parameters {
    gitParameter(
      name: 'GIT_BRANCH',
      type: 'PT_BRANCH',
      branchFilter: 'origin/(.*)',
      quickFilterEnabled: true,
      defaultValue: 'master',
      description: 'Git branch to build'
    )
    string(
      name: 'releaseVersion',
      defaultValue: params.releaseVersion ? params.releaseVersion : '5.0.0',
      description: 'Version tag for the release artifact (e.g. 5.0.0).'
    )
    string(
      name: 'developmentVersion',
      defaultValue: params.developmentVersion ? params.developmentVersion : '5.0-SNAPSHOT',
      description: 'Next development version after the release (e.g. 5.0-SNAPSHOT). Passed to Maven release:prepare as -DdevelopmentVersion.'
    )
    booleanParam(
     name: 'skipTests',
     defaultValue: true,
     description: 'Skip all unit and functional tests. Defaults to true: CI has no GraphDB license for this public repo.'
    )
    string(
      name: 'SLACK_CHANNEL',
      defaultValue: '#graphdb-notifications',
      description: 'Slack channel for build success and failure notifications (e.g. #graphdb-notifications).'
    )
  }

  environment {
    KEEPER_CREDENTIALS='ksm-jenkins'
    // GitHub bot account, same record as graphdb-workbench. Only used for the commit author here;
    // the push itself is done over SSH with the agent's key, like graphdb-workbench does.
    KEEPER_GIT_RELEASE_RECORD = '8hm1g9HCfBPgoWAmpiHn6w'
    KEEPER_NEXUS_RECORD = 'xRckZaBDxYhmpMgsaT4tCg'
    KEEPER_NVD_API_KEY_RECORD='ejsvY-w_afWMP3gpKMJoOA'
    KEEPER_M2_SETTINGS_RECORD = 'keeper://w6o5mGXWgN7zNvrr6K7QGQ/file/settings.xml'
  }

  stages {
      stage('Download Maven settings') {
        steps {
          withKsm(application: [[credentialsId: env.KEEPER_CREDENTIALS, secrets: [
            [destination: 'file', envVar: '', filePath: 'settings.xml', notation: env.KEEPER_M2_SETTINGS_RECORD]
          ]]]) {
            sh """
              mkdir -p ${WORKSPACE}/.m2
              cp ${WORKSPACE}/settings.xml ${WORKSPACE}/.m2/settings.xml
            """
          }
        }
      }

      // Commits the release/development versions and creates the tag LOCALLY only (pushChanges=false).
      stage('Release prepare') {
        when {
          expression { params.releaseVersion?.trim() }
        }
        steps {
          withDockerContainer(image: 'docker-registry.ontotext.com/jenkins-builder:0.2-jdk25', args: "-w ${WORKSPACE}") {
            withKeeper(credentials: env.KEEPER_CREDENTIALS, envs: [
              [record: env.KEEPER_GIT_RELEASE_RECORD, prefix: 'GIT_RELEASE', fields: ['login']],
              [record: env.KEEPER_NEXUS_RECORD, prefix: 'NEXUS', fields: ['login', 'password']]
            ]) {
              script {
                def devArg = params.developmentVersion?.trim() ? "-DdevelopmentVersion=${params.developmentVersion}" : ""
                def skipTestsArg = params.skipTests ? '-DskipTests' : ''
                withEnv([
                  "JAVA_HOME=/opt/java/openjdk",
                  "GIT_AUTHOR_NAME=${env.GIT_RELEASE_LOGIN}",
                  "GIT_AUTHOR_EMAIL=${env.GIT_RELEASE_LOGIN}@users.noreply.github.com",
                  "GIT_COMMITTER_NAME=${env.GIT_RELEASE_LOGIN}",
                  "GIT_COMMITTER_EMAIL=${env.GIT_RELEASE_LOGIN}@users.noreply.github.com"
                ]) {
                  sh """
                    shortBranch="\$(echo "\${GIT_BRANCH}" | sed 's|^origin/||')"
                    git checkout -b "\${shortBranch}" 2>/dev/null || git checkout "\${shortBranch}"
                    mvn -B \
                      -Dmaven.repo.local=${WORKSPACE}/.m2/repository \
                      -DreleaseVersion="${params.releaseVersion}" \
                      ${devArg} \
                      -DpushChanges=false \
                      -Darguments="${skipTestsArg} -Dnexus.username=\$NEXUS_LOGIN -Dnexus.password=\$NEXUS_PASSWORD" \
                      -Prelease \
                      release:prepare \
                      -s ${WORKSPACE}/.m2/settings.xml
                  """
                }
              }
            }
          }
        }
      }

      // Builds the tag from the LOCAL repository (localCheckout=true) and deploys it to Nexus.
      stage('Release perform') {
        when {
          expression { params.releaseVersion?.trim() }
        }
        steps {
          withDockerContainer(image: 'docker-registry.ontotext.com/jenkins-builder:0.2-jdk25', args: "-w ${WORKSPACE}") {
            withKeeper(credentials: env.KEEPER_CREDENTIALS, envs: [
              [record: env.KEEPER_NEXUS_RECORD, prefix: 'NEXUS', fields: ['login', 'password']]
            ]) {
              withEnv(["JAVA_HOME=/opt/java/openjdk"]) {
                sh """
                  mvn -B \
                    -Dmaven.repo.local=${WORKSPACE}/.m2/repository \
                    -DreleaseVersion="${params.releaseVersion}" \
                    -DlocalCheckout=true \
                    -Darguments="-DskipTests -Dnexus.username=\$NEXUS_LOGIN -Dnexus.password=\$NEXUS_PASSWORD" \
                    -Prelease \
                    release:perform \
                    -s ${WORKSPACE}/.m2/settings.xml
                """
              }
            }
          }
        }
      }

      // Pushes the release commits and tag from the agent over SSH, same as graphdb-workbench.
      stage('Push to GitHub') {
        when {
          expression { params.releaseVersion?.trim() }
        }
        steps {
          sh """
            mkdir -p ~/.ssh
            ssh-keyscan github.com >> ~/.ssh/known_hosts
            shortBranch="\$(echo "\${GIT_BRANCH}" | sed 's|^origin/||')"
            git remote set-url origin git@github.com:Ontotext-AD/graphdb-autocomplete-plugin.git
            git push origin "HEAD:refs/heads/\${shortBranch}"
            git push origin "refs/tags/${params.releaseVersion}"
          """
        }
      }
    }

    post {
      always {
        script {
          currentBuild.displayName = "${params.releaseVersion ?: 'unknown'}"
        }
      }
      success {
        slackSend(
          channel: params.SLACK_CHANNEL,
          color: 'good',
          message: "autocomplete-plugin release succeeded: version ${params.releaseVersion} ${env.JOB_NAME} #${env.BUILD_NUMBER}\n${env.BUILD_URL}"
        )
      }

      unstable {
        slackSend(
          channel: params.SLACK_CHANNEL,
          color: 'danger',
          message: "autocomplete-plugin release unstable: version ${params.releaseVersion} ${env.JOB_NAME} #${env.BUILD_NUMBER}\n${env.BUILD_URL}"
        )
      }

      failure {
        script {
          withDockerContainer(image: 'docker-registry.ontotext.com/jenkins-builder:0.2-jdk25', args: "-w ${WORKSPACE}") {
            withEnv(['JAVA_HOME=/opt/java/openjdk']) {
               sh '''
                 set +e
                 mvn -B -DpushChanges=false release:rollback
                 mvn -B release:clean -s ${WORKSPACE}/.m2/settings.xml
                 set -e
               '''
             }
          }
        }
        slackSend(
          channel: params.SLACK_CHANNEL,
          color: 'danger',
          message: "autocomplete-plugin release failed: version ${params.releaseVersion} ${env.JOB_NAME} #${env.BUILD_NUMBER}\n${env.BUILD_URL}"
        )
      }
    }
  }
